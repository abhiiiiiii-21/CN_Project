# dnsmasq for the team zone
# Rendered by render-configs.sh for Mac 1 (primary DNS).
# The backup resolver uses config/phase2/dnsmasq-backup.conf.template.
# Both files must carry identical host-record lines.

listen-address=127.0.0.1,LISTEN_IP
bind-interfaces

no-resolv
server=COLLEGE_DNS
server=1.1.1.1

local=/TEAM.test/
# TTL for our own records: clients cache the app name for 30 s (Ext B).
local-ttl=30
host-record=app.TEAM.test,MAC2_IP
host-record=api.TEAM.test,MAC2_IP

domain-needed
bogus-priv
log-queries
