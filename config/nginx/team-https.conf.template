# ==============================================================================
# Nginx HTTPS Load Balancer Configuration Template
# ==============================================================================
# Rendered twice by render-configs.sh:
#   config/live/team-https.conf          -> Mac 2 primary edge  (X-Edge: mac2-primary)
#   config/live/team-https-standby.conf  -> Mac 3 standby edge  (X-Edge: mac3-standby)
# Backend A runs on Mac 3 :3001, Backend B on Mac 4 :3002.

upstream team_backend {
    server MAC3_IP:3001;
    server MAC4_IP:3002;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name app.TEAM.test api.TEAM.test;

    # TLS Certificates (Placeholders - do not commit private keys)
    ssl_certificate CERTIFICATE_PATH;       # e.g., /path/to/certs/app.crt
    ssl_certificate_key PRIVATE_KEY_PATH;   # e.g., /path/to/certs/app.key

    # TLS Protocol & Cipher Suite Settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Reverse proxy to the backend pool
    location / {
        proxy_pass http://team_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # Which edge answered, and which upstream(s) it tried
        add_header X-Edge EDGE_NAME always;
        add_header X-Upstream-Addr $upstream_addr always;

        # Timeouts and failover settings
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        proxy_next_upstream error timeout http_502 http_503;
    }
}
